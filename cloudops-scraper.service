[Unit]
Description=CloudOps Hub - Autonomous ARM Scraper (Cloud Edition)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/cloudops-scraper
ExecStart=/usr/local/bin/node /home/ubuntu/cloudops-scraper/scraper.js
Restart=always
RestartSec=10
MemoryMax=60M
CPUQuota=15%
StandardOutput=append:/home/ubuntu/cloudops-scraper/scraper.log
StandardError=append:/home/ubuntu/cloudops-scraper/scraper.log

[Install]
WantedBy=multi-user.target
